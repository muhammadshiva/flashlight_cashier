{
  "_info": {
    "endpoint": "GET /api/work-orders/history",
    "method": "GET",
    "base_url": "https://369820dfc74d.ngrok-free.app/api",
    "full_url": "https://369820dfc74d.ngrok-free.app/api/work-orders/history",
    "description": "Mengambil daftar riwayat work order yang sudah selesai (completed/paid) beserta data customer dan kendaraan",
    "authentication": "Bearer Token (required)",
    "headers": {
      "Authorization": "Bearer <token>",
      "Accept": "application/json"
    }
  },

  "_query_parameters": {
    "description": "Query parameter untuk filter, pencarian, dan paginasi",
    "parameters": {
      "status": {
        "type": "string",
        "required": false,
        "enum": ["completed", "paid"],
        "default": null,
        "description": "Filter berdasarkan status order. Jika tidak diisi, menampilkan semua (completed + paid)"
      },
      "search": {
        "type": "string",
        "required": false,
        "default": null,
        "description": "Pencarian berdasarkan: workOrderCode, nama customer, nomor telepon customer, info kendaraan (brand, spesifikasi, plat nomor)"
      },
      "startDate": {
        "type": "string (ISO8601)",
        "required": false,
        "default": null,
        "description": "Filter tanggal mulai (format: 2026-02-17T00:00:00.000Z). Berdasarkan completedAt/updatedAt/createdAt"
      },
      "endDate": {
        "type": "string (ISO8601)",
        "required": false,
        "default": null,
        "description": "Filter tanggal akhir (format: 2026-02-17T23:59:59.000Z). Berdasarkan completedAt/updatedAt/createdAt"
      },
      "page": {
        "type": "integer",
        "required": false,
        "default": 1,
        "description": "Nomor halaman untuk paginasi (dimulai dari 1)"
      },
      "per_page": {
        "type": "integer",
        "required": false,
        "default": 10,
        "description": "Jumlah item per halaman (sesuai MetaModel.perPage)"
      }
    },
    "example_urls": [
      "/api/work-orders/history",
      "/api/work-orders/history?status=paid&page=1&per_page=10",
      "/api/work-orders/history?search=Ahmad&startDate=2026-02-01T00:00:00.000Z&endDate=2026-02-17T23:59:59.000Z",
      "/api/work-orders/history?status=completed&search=WO-2026&page=2&limit=10"
    ]
  },

